# Copy to deploy/compose.env and use: docker compose --env-file deploy/compose.env --profile app up -d --build
# Never commit deploy/compose.env.

# Public address. With a domain, Caddy serves HTTPS automatically; set COOKIE_SECURE=true then.
SITE_ADDRESS=:80
PUBLIC_ORIGIN=http://localhost:8080
PROXY_PORT=8080
# Production with a domain: PROXY_PORT=80 and PROXY_TLS_PORT=443 (Caddy needs both for certificates).
PROXY_TLS_PORT=8443
COOKIE_SECURE=false

# Secrets: generate each with  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
POSTGRES_PASSWORD=
SESSION_SECRET=
S3_ACCESS_KEY_ID=tailorite
S3_SECRET_ACCESS_KEY=

# AI: live (needs GEMINI_API_KEY), fixture (labelled demo examples) or off (manual mode).
AI_MODE=live
GEMINI_API_KEY=

# Public demo sandboxes (synthetic data, isolated per visitor, deleted automatically).
DEMO_SANDBOX_ENABLED=true
# Presenter seed ("Amina Atelier"): only when ALLOW_DEMO_SEED=true and a password is set.
ALLOW_DEMO_SEED=false
DEMO_OWNER_PASSWORD=
