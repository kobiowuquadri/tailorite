# Tailorite web app configuration. Copy to `.env.local`.
#
# Server-only: where the Next.js server forwards /api/* (the NestJS API).
# The browser always talks to this app's own origin, so session cookies stay first-party.
# Production builds resolve rewrites at build time — set this before `pnpm build`.
API_INTERNAL_URL=http://localhost:4000

# Browser tests (`pnpm test:e2e`) start their own isolated stack; these override its addresses.
# E2E_BASE_URL=http://localhost:3100
# E2E_API_URL=http://localhost:4100
# E2E_SKIP_BUILD=1
