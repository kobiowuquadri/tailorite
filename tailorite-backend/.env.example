# Tailorite API + worker configuration.
# Copy to `.env` and adjust. Every value here is a safe placeholder — never commit real secrets.
# All variables are server-only. The web app never receives these values.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
# Port the NestJS API listens on. The web app proxies /api/* to it.
PORT=4000
# Public origin of the web application (scheme + host + port, no trailing slash).
# Used for cookie/CSRF origin checks and for building customer review links.
APP_ORIGIN=http://localhost:3000
# Express "trust proxy" setting. Use "loopback" locally, the proxy hop count/CIDR in production.
TRUST_PROXY=loopback
# Log level: debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------- database
# PostgreSQL connection string (source of truth for all data, sessions and job state).
# Local without Docker: `pnpm db:local` starts an embedded PostgreSQL on this URL.
# Hosted databases with a self-signed certificate (e.g. Clever Cloud): append
#   ?sslmode=require&uselibpqcompat=true   (encrypted; the certificate is not verified)
# If DATABASE_URL is empty and a Clever Cloud PostgreSQL add-on is linked, POSTGRESQL_ADDON_URI is used that way.
DATABASE_URL=postgresql://tailorite:tailorite@localhost:5432/tailorite
# When DATABASE_URL points at a hosted database: where `pnpm db:local` runs the embedded server, and
# the database the browser tests recreate (keeps tests off the hosted database).
# LOCAL_DATABASE_URL=postgresql://tailorite:tailorite@localhost:5432/tailorite
# E2E_DATABASE_URL=postgresql://tailorite:tailorite@localhost:5432/tailorite_e2e
# Max connections per process (API and worker each hold their own pool).
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------- sessions & secrets
# 32+ random characters. Signs customer portal sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Owner sessions: absolute lifetime and idle timeout (days).
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=7
# Set to true when the app is served over HTTPS (production). Adds the Secure cookie flag.
COOKIE_SECURE=false

# ---------------------------------------------------------------- background jobs (BullMQ)
# redis    -> BullMQ on Redis (Docker Compose)
# postgres -> BullMQ's PostgreSQL backend (no Redis needed; used for local dev without Docker)
# database -> no queue service: the worker polls the ExtractionJob table every JOB_POLL_INTERVAL_MS.
#             Opens no extra connections — use it with small hosted databases (e.g. 5-connection plans).
JOB_QUEUE_BACKEND=postgres
JOB_POLL_INTERVAL_MS=2000
# true -> the API process also runs the worker (single-service hosting such as Render's free tier).
WORKER_IN_API=false
REDIS_URL=redis://localhost:6379
# Concurrent extraction jobs per worker process.
WORKER_CONCURRENCY=2
# Attempts per extraction job before it is marked failed (temporary errors only).
EXTRACTION_MAX_ATTEMPTS=3
# Delay before the first automatic retry of a temporary AI failure (later retries back off x4, max 10 min).
EXTRACTION_RETRY_BASE_MS=20000

# ---------------------------------------------------------------- private file storage
# cloudinary -> Cloudinary (free plan works). Files are private "authenticated" raw assets that the API
#               streams after its own access checks. Set CLOUDINARY_URL (Cloudinary console > Settings >
#               API Keys > "API environment variable"); setting it also selects this driver.
#               The free plan caps raw files at 10 MB, so also set UPLOAD_MAX_AUDIO_MB=10.
# s3         -> any S3-compatible private bucket (MinIO locally via Compose; Cellar, B2, S3 or R2 in production)
#               With a linked Clever Cloud Cellar add-on, S3_ENDPOINT and the keys default to CELLAR_ADDON_* (use S3_REGION=default).
# local      -> private directory on local disk (development only; not for multi-instance deploys)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.local/storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tailorite-private
S3_ACCESS_KEY_ID=minio-access-key-placeholder
S3_SECRET_ACCESS_KEY=minio-secret-key-placeholder
S3_FORCE_PATH_STYLE=true
# Create the bucket on first use if it is missing (default: true outside production). The bucket must stay private.
# S3_CREATE_BUCKET=true
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Prefix for every stored file in Cloudinary (default: tailorite).
# CLOUDINARY_FOLDER=tailorite

# ---------------------------------------------------------------- AI provider
# live    -> real Gemini calls (requires GEMINI_API_KEY; without it the UI says "AI extraction is not configured")
# fixture -> deterministic, visibly labelled example results for the synthetic demo sources only
# off     -> manual mode: intake, editing, approval and revisions work without AI
AI_MODE=live
GEMINI_API_KEY=
# Model identifiers (verify against https://ai.google.dev/gemini-api/docs/models before changing).
GEMINI_EXTRACTION_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-3.8-flash
# Per-call timeout and output cap.
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_OUTPUT_TOKENS=8192
# Cost guards.
AI_MAX_JOBS_PER_STUDIO_PER_DAY=40
AI_MAX_SOURCES_PER_JOB=12
AI_MAX_INPUT_MB_PER_JOB=30

# ---------------------------------------------------------------- upload limits
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_AUDIO_MB=25
# Longest accepted audio file (seconds). Browser recordings are capped separately at 5 minutes.
UPLOAD_MAX_AUDIO_SECONDS=600
UPLOAD_MAX_ORDER_TOTAL_MB=150
UPLOAD_MAX_SOURCES_PER_ORDER=40
TEXT_SOURCE_MAX_CHARS=20000

# ---------------------------------------------------------------- customer links
APPROVAL_LINK_TTL_DAYS=14
CHANGE_LINK_TTL_DAYS=7
PORTAL_SESSION_TTL_MINUTES=120

# ---------------------------------------------------------------- demo
# Public "Explore demo": each visitor gets an isolated, synthetic sandbox studio.
DEMO_SANDBOX_ENABLED=true
DEMO_SANDBOX_TTL_HOURS=24
# fixture (default, no provider cost) or live (uses Gemini if configured).
DEMO_SANDBOX_AI=fixture
# `pnpm demo:seed` refuses to run when NODE_ENV=production unless this is true.
ALLOW_DEMO_SEED=false
# Login for the seeded presenter studio "Amina Atelier" (synthetic data only).
DEMO_OWNER_EMAIL=demo@tailorite.local
DEMO_OWNER_PASSWORD=change-this-demo-password
