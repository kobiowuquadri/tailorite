{
  "name": "tailorite-backend",
  "version": "0.1.0",
  "description": "Tailorite API and extraction worker (NestJS modular monolith)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "db:local": "node scripts/local-postgres.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "dev:all": "concurrently -k -n db,api,worker,web -c gray,blue,magenta,green \"pnpm db:local\" \"pnpm wait:db && pnpm db:migrate && pnpm dev\" \"pnpm wait:db && pnpm wait:api && pnpm dev:worker\" \"pnpm wait:api && pnpm --dir ../tailorite-frontend dev\"",
    "wait:db": "node scripts/wait-for.mjs db",
    "wait:api": "node scripts/wait-for.mjs api",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "demo:seed": "node --enable-source-maps dist/cli/demo-seed.js",
    "doctor": "node --enable-source-maps dist/cli/doctor.js",
    "demo:assets": "node scripts/generate-demo-assets.mjs",
    "lint": "oxlint --type-aware src/ test/",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@google/genai": "^2.29.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "^6.3.14",
    "cloudinary": "2.11.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.7",
    "ioredis": "^6.0.0",
    "music-metadata": "^12.2.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "embedded-postgres": "18.4.0-beta.17",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
